{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/check-missing-cuts",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/check-missing-cuts",
      "schedule": "0 4 * * *"
    }
  ]
}
